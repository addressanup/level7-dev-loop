{
  "schema": 1,
  "name": "level7-dev-loop",
  "version": "0.1.0",
  "channel": "stable",
  "description": "One-intent solo development: inspect, implement, test, repair, self-review, and hand off with optional team assurance.",
  "author": {
    "name": "Level 7 Engineering"
  },
  "homepage": "https://github.com/addressanup/level7-dev-loop#readme",
  "repository": "https://github.com/addressanup/level7-dev-loop",
  "license": "MIT",
  "keywords": [
    "workflow",
    "architecture",
    "release",
    "risk-tier",
    "ux",
    "multi-tenant"
  ],
  "skills": [
    "l7-build",
    "l7-change",
    "l7-constitution",
    "l7-deploy",
    "l7-experience",
    "l7-geometry",
    "l7-greenfield",
    "l7-next",
    "l7-ops",
    "l7-release",
    "l7-review",
    "l7-storybook"
  ],
  "permissions": {
    "level7_network": false,
    "bundled_executable": false,
    "mcp_server": false,
    "hook": false,
    "host_setting": false,
    "telemetry": false,
    "workspace_boundary": "The package contributes instructions only; the surrounding host retains its independently configured workspace, tools, network, memory, and provider behavior."
  },
  "hosts": {
    "codex": {
      "manifest_path": ".codex-plugin/plugin.json",
      "catalog_path": ".agents/plugins/marketplace.json",
      "display_name": "Level 7 Dev Loop",
      "category": "Developer Tools",
      "invocation": "$l7-next"
    },
    "claude": {
      "manifest_path": ".claude-plugin/plugin.json",
      "catalog_path": ".claude-plugin/marketplace.json",
      "display_name": "Level 7 Dev Loop",
      "category": "Development Tools",
      "invocation": "/level7-dev-loop:l7-next"
    }
  }
}
