      "type": "object",
      "description": "Closed applicability dimensions.",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "contraindications",
        "effects",
        "hosts",
        "profiles",
        "risks",
        "stages"
      ],
      "properties": {
