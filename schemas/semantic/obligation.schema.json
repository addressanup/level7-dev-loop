{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/semantic/obligation.schema.json",
  "title": "Level 7 semantic obligation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicability",
    "change_gate",
    "compatibility",
    "criticality",
    "definition",
    "earliest_removal",
    "enforcement_locus",
    "evidence_rule",
    "grader_ids",
    "id",
    "introduced_by",
    "machine_only",
    "overrideability",
