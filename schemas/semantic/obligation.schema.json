          "type": "array",
          "description": "Sorted capabilities set.",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "description": "capabilities item."
          }
        },
        "contraindications": {
          "type": "array",
