    },
    "status": {
      "type": "string",
      "description": "Typed status value."
    },
    "supersedes": {
      "type": "array",
      "description": "Sorted supersedes set.",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
