            "type": "string",
            "description": "contraindications item."
          }
        },
        "effects": {
          "type": "array",
          "description": "Sorted effects set.",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "description": "effects item."
          }
        },
        "hosts": {
          "type": "array",
          "description": "Sorted hosts set.",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
