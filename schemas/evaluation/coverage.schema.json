{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/evaluation/coverage.schema.json",
  "title": "Level 7 evaluation coverage record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axes",
    "change_gate",
    "compatibility",
    "definition",
    "earliest_removal",
    "id",
    "introduced_by",
    "obligation_ids",
    "owner",
    "replacement",
    "requirement_ids",
    "retained_tests",
    "reviewer",
    "schema_version",
    "status",
    "supersedes",
    "version"
  ],
  "properties": {
    "change_gate": {
      "type": "string",
      "description": "Separate evaluator-control change gate."
    },
    "compatibility": {
      "type": "string",
      "description": "Compatibility and invalidation rule."
    },
    "definition": {
      "type": "string",
      "description": "Provider-neutral normative record definition."
    },
    "earliest_removal": {
      "type": "string",
      "description": "Earliest compatible removal gate."
    },
    "id": {
      "type": "string",
      "description": "Stable evaluator record identity.",
      "pattern": "^L7-(TAX|OBL|GUARD|KNOW|WF|PROF|BUDGET|EVAL|CASE|TRUTH|EGR|COV|ADJ)-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "introduced_by": {
      "type": "string",
      "description": "Approved introducing design identity."
    },
    "owner": {
      "type": "string",
      "description": "Exactly one evaluator-governance owner."
    },
    "replacement": {
      "type": "array",
      "description": "Sorted replacement identities.",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Replacement identity."
      }
    },
    "retained_tests": {
      "type": "array",
      "description": "Sorted retained stable-rule tests.",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Stable retained-test rule."
      }
    },
    "reviewer": {
      "type": "string",
      "description": "Independent read-only reviewer role."
    },
    "schema_version": {
      "type": "string",
      "description": "Record schema version.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "type": "string",
      "description": "Record lifecycle status.",
      "enum": [
        "active",
        "deprecated",
        "draft",
        "retired",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "array",
      "description": "Sorted superseded identities.",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Superseded identity."
      }
    },
    "version": {
      "type": "string",
      "description": "Semantic record version.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "axes": {
      "type": "array",
      "description": "Requirement-owning coverage entries.",
      "minItems": 29,
      "maxItems": 29,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "description": "Closed requirement ownership and support links.",
        "additionalProperties": false,
        "required": [
          "axis",
          "case_ids",
          "feature",
          "grader_ids",
          "obligation_id",
          "requirement_id",
          "truth_ids"
        ],
        "properties": {
          "axis": {
            "type": "string",
            "description": "Required semantic or safety axis."
          },
          "case_ids": {
            "type": "array",
            "description": "Sorted supporting case identities.",
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "Case identity."
            }
          },
          "feature": {
            "type": "string",
            "description": "Owning backlog feature."
          },
          "grader_ids": {
            "type": "array",
            "description": "Sorted supporting grader identities.",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "Grader identity."
            }
          },
          "obligation_id": {
            "type": "string",
            "description": "Exactly one derived obligation identity."
          },
          "requirement_id": {
            "type": "string",
            "description": "Exactly one approved requirement identity."
          },
          "truth_ids": {
            "type": "array",
            "description": "Sorted supporting truth identities.",
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "description": "Truth identity."
            }
          }
        }
      }
    },
    "obligation_ids": {
      "type": "array",
      "description": "Exact sorted 29-obligation roster.",
      "minItems": 29,
      "maxItems": 29,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Derived obligation identity."
      }
    },
    "requirement_ids": {
      "type": "array",
      "description": "Exact sorted 29-requirement roster.",
      "minItems": 29,
      "maxItems": 29,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Approved requirement identity."
      }
    }
  }
}
