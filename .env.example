# Documentation only: the harness never auto-loads this file.
# Never place provider credentials, secrets, approval data, or mutation controls here.
L7_LOG_FORMAT=json
L7_LOG_LEVEL=INFO
L7_ASSURANCE_MODE=solo
L7_TELEMETRY=off
L7_NETWORK=off
# Plugin installer prefix (defaults: ~/.local/share/level7 and ~/.local/bin).
# L7_HOME=/absolute/path
# L7_BIN_DIR=/absolute/path
