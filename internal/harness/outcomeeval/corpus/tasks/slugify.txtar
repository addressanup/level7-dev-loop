# l7-outcome-eval-canary-7c1e4b2a
import unittest

from textkit.case import title_words
from textkit.slug import slugify


class HiddenSlugifyTest(unittest.TestCase):
    def test_separators(self):
        self.assertEqual(slugify("Hello, World!"), "hello-world")
        self.assertEqual(slugify("  a -- b  "), "a-b")
        self.assertEqual(slugify("one_two.three"), "one-two-three")
        self.assertEqual(slugify("Release v2.0 -- final"), "release-v2-0-final")

    def test_accents(self):
        self.assertEqual(slugify("Crème Brûlée"), "creme-brulee")
        self.assertEqual(slugify("naïve café"), "naive-cafe")
        self.assertEqual(slugify("Ünïcödé"), "unicode")

    def test_other_unicode_is_a_separator(self):
        self.assertEqual(slugify("日本 test"), "test")
        self.assertEqual(slugify("a→b"), "a-b")

    def test_max_length(self):
        self.assertEqual(slugify("hello world", max_length=6), "hello")
        self.assertEqual(slugify("hello world", max_length=5), "hello")
        self.assertEqual(slugify("hello world", max_length=3), "hel")
        self.assertEqual(slugify("hello world", max_length=11), "hello-world")
        self.assertEqual(slugify("hello world", max_length=None), "hello-world")
        for bad in (0, -1):
            with self.assertRaises(ValueError):
                slugify("hello", max_length=bad)

    def test_empty(self):
        self.assertEqual(slugify(""), "")
        self.assertEqual(slugify("!!! ---"), "")
        self.assertEqual(slugify("日本"), "")

    def test_existing_helper(self):
        self.assertEqual(title_words("hello  world"), "Hello World")
-- reference/textkit/slug.py --
# l7-outcome-eval-canary-7c1e4b2a
"""URL slug helper."""

import re
import unicodedata

_SEPARATORS = re.compile(r"[^a-z0-9]+")


def slugify(text, max_length=None):
    """Return a lowercase ASCII slug of text, optionally truncated."""
    if max_length is not None and max_length < 1:
        raise ValueError("max_length must be at least 1")
    decomposed = unicodedata.normalize("NFKD", text)
    stripped = "".join(character for character in decomposed if not unicodedata.combining(character))
    slug = _SEPARATORS.sub("-", stripped.lower()).strip("-")
    if max_length is not None:
        slug = slug[:max_length].rstrip("-")
    return slug
