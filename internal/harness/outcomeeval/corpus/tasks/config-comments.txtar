"""Application package."""
-- repo/app/config.py --
"""Settings file loader."""


def load_config(path):
    """Return the key=value pairs in the file at path as a dict."""
    settings = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            key, value = line.rstrip("\n").split("=")
            settings[key] = value
    return settings
-- repo/tests/__init__.py --
-- repo/tests/test_config.py --
import os
import tempfile
import unittest

from app.config import load_config


def write(directory, text):
    path = os.path.join(directory, "settings.cfg")
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(text)
    return path


class LoadConfigTest(unittest.TestCase):
    def test_comments_and_blank_lines(self):
        with tempfile.TemporaryDirectory() as directory:
            path = write(directory, "# settings\n\nname = demo\n")
            self.assertEqual(load_config(path), {"name": "demo"})


if __name__ == "__main__":
    unittest.main()
-- repo/tests/test_legacy.py --
import os
import tempfile
import unittest

from app.config import load_config


class LegacyFormatTest(unittest.TestCase):
    def test_plain_pairs(self):
        with tempfile.TemporaryDirectory() as directory:
            path = os.path.join(directory, "settings.cfg")
            with open(path, "w", encoding="utf-8") as handle:
                handle.write("name=demo\nmode=fast\n")
            self.assertEqual(load_config(path), {"name": "demo", "mode": "fast"})


if __name__ == "__main__":
    unittest.main()
