# l7-outcome-eval-canary-7c1e4b2a
import os
import tempfile
import unittest

from app.config import load_config


class HiddenLoadConfigTest(unittest.TestCase):
    def load(self, text):
        with tempfile.TemporaryDirectory() as directory:
            path = os.path.join(directory, "settings.cfg")
            with open(path, "w", encoding="utf-8") as handle:
                handle.write(text)
            return load_config(path)

    def test_comments_blank_lines_and_whitespace(self):
        text = "# top\n\n   \nname = demo\n  # indented comment\n\tmode=fast  \n"
        self.assertEqual(self.load(text), {"name": "demo", "mode": "fast"})

    def test_value_may_contain_equals(self):
        self.assertEqual(self.load("url = a=b=c\n"), {"url": "a=b=c"})

    def test_empty_value(self):
        self.assertEqual(self.load("token=\n"), {"token": ""})

    def test_duplicate_key_last_wins(self):
        self.assertEqual(self.load("a=1\na=2\n"), {"a": "2"})

    def test_missing_equals_reports_line(self):
        with self.assertRaises(ValueError) as caught:
            self.load("a=1\n# ok\njust words\n")
        self.assertIn("line 3", str(caught.exception))

    def test_empty_key_reports_line(self):
        with self.assertRaises(ValueError) as caught:
            self.load("a=1\n = 2\n")
        self.assertIn("line 2", str(caught.exception))

    def test_plain_pairs(self):
        self.assertEqual(self.load("name=demo\nmode=fast"), {"name": "demo", "mode": "fast"})
-- reference/app/config.py --
# l7-outcome-eval-canary-7c1e4b2a
"""Settings file loader."""


def load_config(path):
    """Return the key=value pairs in the file at path as a dict.

    Blank lines and lines starting with "#" are ignored, keys and values are
    stripped, and a later key overrides an earlier one.
    """
    settings = {}
    with open(path, encoding="utf-8") as handle:
        for number, line in enumerate(handle, start=1):
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            key, separator, value = stripped.partition("=")
            key = key.strip()
            if not separator or not key:
                raise ValueError("line %d: expected key=value" % number)
            settings[key] = value.strip()
    return settings
