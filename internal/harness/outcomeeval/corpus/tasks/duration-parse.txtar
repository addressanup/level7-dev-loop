# l7-outcome-eval-canary-7c1e4b2a
import unittest

from timeparse.duration import parse_duration


class HiddenParseDurationTest(unittest.TestCase):
    def test_combined(self):
        self.assertEqual(parse_duration("1h30m"), 5400)
        self.assertEqual(parse_duration("2h5m10s"), 7510)
        self.assertEqual(parse_duration("10m5s"), 605)
        self.assertEqual(parse_duration("1h1s"), 3601)
        self.assertIsInstance(parse_duration("1h30m"), int)

    def test_single(self):
        self.assertEqual(parse_duration("90s"), 90)
        self.assertEqual(parse_duration("15m"), 900)
        self.assertEqual(parse_duration("2h"), 7200)
        self.assertEqual(parse_duration("0s"), 0)

    def test_order_and_repetition(self):
        for text in ("30m1h", "1h1h", "5s2m", "1m1m"):
            with self.assertRaises(ValueError, msg=text):
                parse_duration(text)

    def test_malformed(self):
        for text in ("", "1h30", "5x", "h", "-5m", "+5m", "1 h", " 1h", "1h ", "1.5h"):
            with self.assertRaises(ValueError, msg=text):
                parse_duration(text)
-- reference/timeparse/duration.py --
# l7-outcome-eval-canary-7c1e4b2a
"""Parse human-readable durations."""

import re

UNITS = {"h": 3600, "m": 60, "s": 1}
_PATTERN = re.compile(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?")


def parse_duration(text):
    """Return the number of seconds in a duration such as "1h30m" or "90s".

    Units must appear in the order h, m, s, each at most once.
    """
    if not isinstance(text, str) or not text:
        raise ValueError("empty duration")
    match = _PATTERN.fullmatch(text)
    if match is None or not any(match.groups()):
        raise ValueError("invalid duration %r" % text)
    hours, minutes, seconds = (int(part) if part else 0 for part in match.groups())
    return hours * UNITS["h"] + minutes * UNITS["m"] + seconds * UNITS["s"]
