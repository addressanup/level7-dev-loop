-- repo/README.md --
# timeparse

`timeparse.duration.parse_duration(text)` converts a duration such as `90s`,
`15m`, or `2h` into a number of seconds.

Run the tests with `python3 -m unittest -q tests.test_duration`.
-- repo/timeparse/__init__.py --
"""Duration parsing helpers."""
-- repo/timeparse/duration.py --
"""Parse human-readable durations."""

UNITS = {"h": 3600, "m": 60, "s": 1}


def parse_duration(text):
    """Return the number of seconds in a duration such as "90s" or "2h"."""
    if not text:
        raise ValueError("empty duration")
    unit = text[-1]
    if unit not in UNITS:
        raise ValueError("unknown unit in %r" % text)
    number = text[:-1]
    if not number.isdigit():
        raise ValueError("invalid number in %r" % text)
    return int(number) * UNITS[unit]
