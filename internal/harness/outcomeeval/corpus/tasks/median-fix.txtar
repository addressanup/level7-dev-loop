# l7-outcome-eval-canary-7c1e4b2a
import unittest

from mathx.stats import median


class HiddenMedianTest(unittest.TestCase):
    def test_original_assertions(self):
        self.assertEqual(median([1, 2, 3]), 2)
        self.assertEqual(median([1, 2, 3, 4]), 2.5)

    def test_unsorted(self):
        self.assertEqual(median([3, 1, 2]), 2)
        self.assertEqual(median([10, -2, 4, 7]), 5.5)
        self.assertEqual(median([5]), 5)

    def test_input_is_not_modified(self):
        values = [3, 1, 2]
        median(values)
        self.assertEqual(values, [3, 1, 2])

    def test_iterables(self):
        self.assertEqual(median((4, 1, 3, 2)), 2.5)
        self.assertEqual(median(value for value in [9, 7, 8]), 8)

    def test_floats(self):
        self.assertAlmostEqual(median([0.5, 0.25, 0.75, 1.0]), 0.625)

    def test_empty(self):
        with self.assertRaises(ValueError) as caught:
            median([])
        self.assertEqual(str(caught.exception), "median of empty sequence")
-- reference/mathx/stats.py --
# l7-outcome-eval-canary-7c1e4b2a
"""Descriptive statistics."""


def median(values):
    """Return the median of a non-empty iterable of numbers."""
    ordered = sorted(values)
    if not ordered:
        raise ValueError("median of empty sequence")
    middle = len(ordered) // 2
    if len(ordered) % 2:
        return ordered[middle]
    return (ordered[middle - 1] + ordered[middle]) / 2
