# l7-outcome-eval-canary-7c1e4b2a
import unittest

from netutil.retry import retry


class Recorder:
    def __init__(self):
        self.delays = []

    def __call__(self, seconds):
        self.delays.append(seconds)


def failing(error):
    def fail():
        raise error

    return fail


class HiddenRetryTest(unittest.TestCase):
    def test_success_after_failures(self):
        calls = []

        def flaky():
            calls.append(1)
            if len(calls) < 3:
                raise OSError("again")
            return "ok"

        sleep = Recorder()
        self.assertEqual(retry(flaky, attempts=5, base_delay=0.5, sleep=sleep), "ok")
        self.assertEqual(sleep.delays, [0.5, 1.0])

    def test_backoff_is_capped_without_a_final_sleep(self):
        sleep = Recorder()
        with self.assertRaises(OSError):
            retry(failing(OSError("down")), attempts=5, base_delay=0.5, max_delay=1.5, sleep=sleep)
        self.assertEqual(sleep.delays, [0.5, 1.0, 1.5, 1.5])

    def test_default_schedule(self):
        sleep = Recorder()
        with self.assertRaises(ValueError):
            retry(lambda: int("x"), sleep=sleep)
        self.assertEqual(sleep.delays, [0.1, 0.2])

    def test_reraises_the_last_exception_object(self):
        errors = [OSError("first"), OSError("second")]
        last = errors[1]

        def fail():
            raise errors.pop(0)

        with self.assertRaises(OSError) as caught:
            retry(fail, attempts=2, sleep=Recorder())
        self.assertIs(caught.exception, last)

    def test_only_listed_exceptions_are_retried(self):
        sleep = Recorder()
        calls = []

        def fail():
            calls.append(1)
            raise KeyError("no")

        with self.assertRaises(KeyError):
            retry(fail, attempts=4, retry_on=(OSError,), sleep=sleep)
        self.assertEqual((len(calls), sleep.delays), (1, []))

    def test_single_attempt(self):
        sleep = Recorder()
        with self.assertRaises(OSError):
            retry(failing(OSError("x")), attempts=1, sleep=sleep)
        self.assertEqual(sleep.delays, [])

    def test_validation_happens_before_calling(self):
        calls = []
        for options in ({"attempts": 0}, {"base_delay": -0.1}, {"base_delay": 1.0, "max_delay": 0.5}):
            with self.assertRaises(ValueError, msg=repr(options)):
                retry(lambda: calls.append(1), sleep=Recorder(), **options)
        self.assertEqual(calls, [])
