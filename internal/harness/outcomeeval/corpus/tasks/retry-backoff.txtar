# l7-outcome-eval-canary-7c1e4b2a
"""Retry helper."""

import time


def retry(func, attempts=3, base_delay=0.1, max_delay=2.0, retry_on=(Exception,), sleep=time.sleep):
    """Call func until it succeeds, backing off exponentially between attempts.

    Only exceptions matching retry_on are retried; when the final attempt
    fails, its exception is re-raised.
    """
    if attempts < 1:
        raise ValueError("attempts must be at least 1")
    if base_delay < 0 or max_delay < base_delay:
        raise ValueError("delays must satisfy 0 <= base_delay <= max_delay")
    for attempt in range(1, attempts + 1):
        try:
            return func()
        except retry_on:
            if attempt == attempts:
                raise
            sleep(min(max_delay, base_delay * 2 ** (attempt - 1)))
