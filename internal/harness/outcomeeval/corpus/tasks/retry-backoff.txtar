-- repo/README.md --
# netutil

`netutil.retry.retry(func, ...)` calls `func` until it succeeds.

Run the tests with `python3 -m unittest -q tests.test_retry`.
-- repo/netutil/__init__.py --
"""Network helpers."""
-- repo/netutil/retry.py --
"""Retry helper."""

import time


def retry(func, attempts=3, delay=0.1, sleep=time.sleep):
    """Call func until it returns, retrying on any exception."""
    for attempt in range(attempts):
        try:
            return func()
        except Exception:
            sleep(delay)
    return None
