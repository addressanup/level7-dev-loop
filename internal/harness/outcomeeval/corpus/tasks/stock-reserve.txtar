-- repo/README.md --
# inventory

`inventory.stock.Stock` tracks units on hand per SKU.

Behaviour that callers rely on:

- `add(sku, qty)` and `remove(sku, qty)` require a positive integer `qty`;
  anything else, including `True`, raises `ValueError`.
- `remove` raises `ValueError("insufficient stock for <sku>")` when fewer
  than `qty` units are available, and then leaves the stock unchanged.
- `available(sku)` is `0` for an unknown SKU.
- `skus()` lists, sorted, the SKUs that have at least one unit on hand.

Run the tests with `python3 -m unittest -q tests.test_stock`.
-- repo/inventory/__init__.py --
"""Stock tracking."""
-- repo/inventory/stock.py --
"""In-memory stock levels."""


def _check_quantity(qty):
    if isinstance(qty, bool) or not isinstance(qty, int) or qty <= 0:
        raise ValueError("quantity must be a positive integer")


class Stock:
    """Units on hand per SKU."""

    def __init__(self):
        self._units = {}

    def add(self, sku, qty):
        _check_quantity(qty)
        self._units[sku] = self._units.get(sku, 0) + qty

    def remove(self, sku, qty):
        _check_quantity(qty)
        if self.available(sku) < qty:
            raise ValueError("insufficient stock for %s" % sku)
        self._units[sku] -= qty
        if self._units[sku] == 0:
            del self._units[sku]

    def available(self, sku):
        return self._units.get(sku, 0)

    def skus(self):
        return sorted(sku for sku, units in self._units.items() if units > 0)
