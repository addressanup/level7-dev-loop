# l7-outcome-eval-canary-7c1e4b2a
import unittest

from inventory.stock import Stock


class HiddenStockTest(unittest.TestCase):
    def setUp(self):
        self.stock = Stock()
        self.stock.add("apple", 5)

    def test_reserve_and_release(self):
        self.stock.reserve("apple", 2)
        self.assertEqual(self.stock.available("apple"), 3)
        self.assertEqual(self.stock.reserved("apple"), 2)
        self.stock.release("apple", 1)
        self.assertEqual(self.stock.available("apple"), 4)
        self.assertEqual(self.stock.reserved("apple"), 1)

    def test_reserve_insufficient(self):
        with self.assertRaises(ValueError) as caught:
            self.stock.reserve("apple", 6)
        self.assertEqual(str(caught.exception), "insufficient stock for apple")
        self.assertEqual((self.stock.available("apple"), self.stock.reserved("apple")), (5, 0))

    def test_release_more_than_reserved(self):
        self.stock.reserve("apple", 2)
        with self.assertRaises(ValueError):
            self.stock.release("apple", 3)
        with self.assertRaises(ValueError):
            self.stock.release("pear", 1)
        self.assertEqual((self.stock.available("apple"), self.stock.reserved("apple")), (3, 2))

    def test_remove_skips_reserved(self):
        self.stock.reserve("apple", 4)
        with self.assertRaises(ValueError) as caught:
            self.stock.remove("apple", 2)
        self.assertEqual(str(caught.exception), "insufficient stock for apple")
        self.assertEqual(self.stock.available("apple"), 1)
        self.stock.remove("apple", 1)
        self.assertEqual((self.stock.available("apple"), self.stock.reserved("apple")), (0, 4))

    def test_quantity_validation(self):
        for method in (self.stock.add, self.stock.remove, self.stock.reserve, self.stock.release):
            for bad in (0, -1, 1.5, "2", True):
                with self.assertRaises(ValueError, msg="%s %r" % (method.__name__, bad)):
                    method("apple", bad)
        self.assertEqual((self.stock.available("apple"), self.stock.reserved("apple")), (5, 0))

    def test_documented_behaviour(self):
        self.assertEqual(self.stock.available("pear"), 0)
        self.assertEqual(self.stock.reserved("pear"), 0)
        with self.assertRaises(ValueError) as caught:
            self.stock.remove("pear", 1)
        self.assertEqual(str(caught.exception), "insufficient stock for pear")
        self.stock.add("banana", 1)
        self.assertEqual(self.stock.skus(), ["apple", "banana"])
        self.stock.remove("banana", 1)
        self.assertEqual(self.stock.skus(), ["apple"])

    def test_fully_reserved_sku_is_listed(self):
        self.stock.reserve("apple", 5)
        self.assertEqual(self.stock.available("apple"), 0)
        self.assertEqual(self.stock.skus(), ["apple"])
        self.stock.release("apple", 5)
        self.assertEqual((self.stock.available("apple"), self.stock.reserved("apple")), (5, 0))
-- reference/inventory/stock.py --
# l7-outcome-eval-canary-7c1e4b2a
"""In-memory stock levels."""


def _check_quantity(qty):
    if isinstance(qty, bool) or not isinstance(qty, int) or qty <= 0:
        raise ValueError("quantity must be a positive integer")


class Stock:
    """Units on hand per SKU, some of which may be reserved."""

    def __init__(self):
        self._units = {}
        self._reserved = {}

    def add(self, sku, qty):
        _check_quantity(qty)
        self._units[sku] = self._units.get(sku, 0) + qty

    def remove(self, sku, qty):
        _check_quantity(qty)
        if self.available(sku) < qty:
            raise ValueError("insufficient stock for %s" % sku)
        self._units[sku] -= qty
        if self._units[sku] == 0:
            del self._units[sku]

    def reserve(self, sku, qty):
        _check_quantity(qty)
        if self.available(sku) < qty:
            raise ValueError("insufficient stock for %s" % sku)
        self._reserved[sku] = self._reserved.get(sku, 0) + qty

    def release(self, sku, qty):
        _check_quantity(qty)
        if self.reserved(sku) < qty:
            raise ValueError("cannot release more than is reserved for %s" % sku)
        self._reserved[sku] -= qty
        if self._reserved[sku] == 0:
            del self._reserved[sku]

    def available(self, sku):
        return self._units.get(sku, 0) - self._reserved.get(sku, 0)

    def reserved(self, sku):
        return self._reserved.get(sku, 0)

    def skus(self):
        return sorted(sku for sku, units in self._units.items() if units > 0)
