import unittest

from inventory.stock import Stock


class StockTest(unittest.TestCase):
    def test_add_and_remove(self):
        stock = Stock()
        stock.add("apple", 5)
        stock.remove("apple", 2)
        self.assertEqual(stock.available("apple"), 3)

    def test_reserve_reduces_available(self):
        stock = Stock()
        stock.add("apple", 5)
        stock.reserve("apple", 2)
        self.assertEqual(stock.available("apple"), 3)


if __name__ == "__main__":
    unittest.main()
