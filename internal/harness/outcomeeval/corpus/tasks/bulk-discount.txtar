import unittest
from decimal import Decimal

from pricing.discount import bulk_total


class BulkTotalTest(unittest.TestCase):
    def test_no_discount_below_ten(self):
        self.assertEqual(bulk_total(9, Decimal("2.00")), Decimal("18.00"))

    def test_five_percent_from_ten(self):
        self.assertEqual(bulk_total(10, Decimal("2.00")), Decimal("19.00"))


if __name__ == "__main__":
    unittest.main()
