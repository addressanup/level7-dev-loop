# l7-outcome-eval-canary-7c1e4b2a
import unittest
from decimal import Decimal

from pricing.discount import bulk_total, line_total


class HiddenBulkTotalTest(unittest.TestCase):
    def test_tiers(self):
        price = Decimal("2.00")
        self.assertEqual(bulk_total(1, price), Decimal("2.00"))
        self.assertEqual(bulk_total(9, price), Decimal("18.00"))
        self.assertEqual(bulk_total(10, price), Decimal("19.00"))
        self.assertEqual(bulk_total(49, price), Decimal("93.10"))
        self.assertEqual(bulk_total(50, price), Decimal("90.00"))
        self.assertEqual(bulk_total(120, price), Decimal("216.00"))

    def test_rounding_after_discount(self):
        self.assertEqual(bulk_total(10, Decimal("0.99")), Decimal("9.41"))
        self.assertEqual(bulk_total(50, Decimal("0.35")), Decimal("15.75"))
        self.assertEqual(bulk_total(3, Decimal("0.335")), Decimal("1.01"))
        self.assertIsInstance(bulk_total(10, Decimal("1.00")), Decimal)
        self.assertEqual(str(bulk_total(5, Decimal("0"))), "0.00")

    def test_validation(self):
        for qty in (0, -1, 2.5, "3", True):
            with self.assertRaises(ValueError, msg=repr(qty)):
                bulk_total(qty, Decimal("1.00"))
        for price in (Decimal("-0.01"), 1.0, 1, "1.00"):
            with self.assertRaises(ValueError, msg=repr(price)):
                bulk_total(1, price)

    def test_line_total_unchanged(self):
        self.assertEqual(line_total(3, Decimal("0.335")), Decimal("1.01"))
        self.assertEqual(line_total(2, "1.10"), Decimal("2.20"))
-- reference/pricing/discount.py --
# l7-outcome-eval-canary-7c1e4b2a
"""Order pricing."""

from decimal import ROUND_HALF_UP, Decimal

CENT = Decimal("0.01")
_TIERS = ((50, Decimal("0.90")), (10, Decimal("0.95")))


def line_total(qty, unit_price):
    """Return qty * unit_price rounded to cents."""
    return (Decimal(qty) * Decimal(unit_price)).quantize(CENT, rounding=ROUND_HALF_UP)


def bulk_total(qty, unit_price):
    """Return the order total after the quantity discount, rounded to cents."""
    if isinstance(qty, bool) or not isinstance(qty, int) or qty <= 0:
        raise ValueError("qty must be a positive integer")
    if not isinstance(unit_price, Decimal) or unit_price < 0:
        raise ValueError("unit_price must be a non-negative Decimal")
    total = Decimal(qty) * unit_price
    for minimum, factor in _TIERS:
        if qty >= minimum:
            total *= factor
            break
    return total.quantize(CENT, rounding=ROUND_HALF_UP)
