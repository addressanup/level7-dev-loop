-- repo/tests/test_cli.py --
import contextlib
import io
import os
import tempfile
import unittest

from wordcount.cli import main


def run(text, *flags):
    with tempfile.TemporaryDirectory() as directory:
        path = os.path.join(directory, "input.txt")
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(text)
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            status = main(list(flags) + [path])
        return status, output.getvalue()


class CliTest(unittest.TestCase):
    def test_total(self):
        self.assertEqual(run("a b a"), (0, "words: 3\n"))

    def test_top(self):
        self.assertEqual(run("b a b c b a", "--top", "2"), (0, "words: 6\nb 3\na 2\n"))


if __name__ == "__main__":
    unittest.main()
